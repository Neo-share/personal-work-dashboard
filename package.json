{
  "name": "project-manager",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @project-manager/shared dev\" \"pnpm --filter @project-manager/server dev\" \"pnpm --filter @project-manager/client dev\"",
    "build": "pnpm --filter @project-manager/shared build && pnpm --filter @project-manager/server build && pnpm --filter @project-manager/client build",
    "start": "pnpm --filter @project-manager/server start",
    "test": "pnpm --filter @project-manager/server test && pnpm --filter @project-manager/client test",
    "test:coverage": "pnpm --filter @project-manager/server test:coverage",
    "test:e2e": "pnpm --filter @project-manager/client test:e2e",
    "verify:dev": "pnpm test:coverage && pnpm --filter @project-manager/client test",
    "agent:gate:dev": "pnpm verify:dev",
    "agent:gate": "pnpm build && pnpm test:coverage && pnpm --filter @project-manager/client test",
    "agent:mechanical-fix": "pnpm build",
    "agent:autoverify:dev": "pnpm verify:dev",
    "agent:autoverify": "pnpm agent:mechanical-fix && pnpm agent:gate",
    "agent:s4:mechanical-loop": "node ops/agent-s4-mechanical-loop.mjs",
    "agent:scope:auto": "node ops/agent-ci-scope.mjs --base=origin/main --head=HEAD",
    "agent:scope:web": "node ops/agent-scope-check.mjs --scope=web",
    "agent:scope:api": "node ops/agent-scope-check.mjs --scope=api",
    "agent:scope:backend": "node ops/agent-scope-check.mjs --scope=backend",
    "agent:scope:contract": "node ops/agent-scope-check.mjs --scope=contract",
    "agent:scope:shared": "node ops/agent-scope-check.mjs --scope=shared",
    "agent:scope:all": "node ops/agent-scope-check.mjs --scope=all",
    "gate:pr": "bash ops/run-gate-pr.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
