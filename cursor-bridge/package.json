{
  "name": "project-manager-cursor-bridge",
  "displayName": "Project Manager Cursor Bridge",
  "description": "接收 project-manager 本地请求，在 Glass 中切换 Workspaces 并新建 Agent",
  "version": "0.1.0",
  "publisher": "project-manager",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onCommand:projectManagerBridge.openAgent"],
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "projectManagerBridge.openAgent",
        "title": "Project Manager: Test Open Agent Bridge"
      },
      {
        "command": "projectManagerBridge.showStatus",
        "title": "Project Manager: Show Bridge Status"
      }
    ],
    "configuration": {
      "title": "Project Manager Bridge",
      "properties": {
        "projectManagerBridge.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 project-manager 本地 HTTP 桥接"
        },
        "projectManagerBridge.port": {
          "type": "number",
          "default": 17320,
          "minimum": 1024,
          "maximum": 65535,
          "description": "桥接服务监听端口（仅 127.0.0.1）"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.2"
  }
}
