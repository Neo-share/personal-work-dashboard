# 可选：服务端口，默认 3100
# PORT=3100

# --- LLM（OpenAI 兼容 API）---
# 必填：接入大模型后设置；未配置时 AI 生成仍走规则模板
# LLM_API_KEY=sk-...

# 必填：兼容端点（DeepSeek / 通义等 OpenAI 格式代理）
# LLM_API_BASE=https://api.openai.com/v1

# 可选：模型名，未设置时为 gpt-4o-mini
# LLM_MODEL=deepseek-chat

# 可选：请求超时毫秒数，默认 30000
# LLM_TIMEOUT_MS=30000

# --- 飞书 Document MCP HTTP 桥接（F4）---
# 指向本地 MCP HTTP 桥接；未配置时不拉取 externalSnippets，主链路不受影响
# FEISHU_MCP_HTTP_URL=http://127.0.0.1:3333/mcp/feishu/get_doc_content
# FEISHU_MCP_TIMEOUT_MS=15000
# FEISHU_MCP_MAX_DOCS=3
# FEISHU_MCP_EXCERPT_CHARS=1500
