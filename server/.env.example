# 可选：服务端口，默认 3100
# PORT=3100

# --- LLM（OpenAI 兼容 API）---
# 必填：接入大模型后设置；未配置时 AI 生成仍走规则模板
# LLM_API_KEY=sk-...

# 必填：兼容端点（DeepSeek / 通义等 OpenAI 格式代理）
# LLM_API_BASE=https://api.openai.com/v1

# 可选：请求超时毫秒数，默认 30000
# LLM_TIMEOUT_MS=30000

# 按任务难度分档（默认走简单模型）：
# - LLM_MODEL_SIMPLE：标题提取、时间 slot 解析、健康检查
# - LLM_MODEL_COMPLEX：待办 AI 初步 HTML 生成
# - LLM_MODEL_DIFFICULT：待办 AI 多轮修订（含上下文）
# 未配高档时向低档回退；未配 SIMPLE 时为 gpt-4o-mini
# LLM_MODEL_SIMPLE=deepseek-v4-flash
# LLM_MODEL_COMPLEX=glm-5.1
# LLM_MODEL_DIFFICULT=claude-sonnet-4.6

# --- 飞书文档集成（F4，server 内直接调用 Open API）---
# 配置 FEISHU_APP_ID / FEISHU_APP_SECRET 后，个人助手消息含飞书文档 URL 时可注入 externalSnippets
# 用户 token 复用 ~/.feishu-mcp（与 Cursor 飞书 MCP 共用 OAuth 缓存）；无缓存时降级应用身份
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_MCP_TIMEOUT_MS=15000
# FEISHU_MCP_MAX_DOCS=3
# FEISHU_MCP_EXCERPT_CHARS=1500
